<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.home.qna.mapper.QnaMapper">

    <sql id="statusCondition">
        <if test="status != null and status.name() == 'WAITING'">
            AND q.answered_at IS NULL
        </if>
        <if test="status != null and status.name() == 'ANSWERED'">
            AND q.answered_at IS NOT NULL
        </if>
    </sql>

    <select id="countAll" resultType="long">
        SELECT COUNT(*)
        FROM qna q
        <where>
            <include refid="statusCondition"/>
        </where>
    </select>

    <select id="findAll" resultType="com.ssafy.home.qna.mapper.dto.QnaResult">
        SELECT
            q.id,
            q.member_id,
            q.title,
            q.content,
            m.name AS author_name,
            q.answer,
            q.answered_at,
            q.created_at,
            q.updated_at
        FROM qna q
        INNER JOIN member m ON m.id = q.member_id
        <where>
            <include refid="statusCondition"/>
        </where>
        ORDER BY q.created_at DESC, q.id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="findById" resultType="com.ssafy.home.qna.mapper.dto.QnaResult">
        SELECT
            q.id,
            q.member_id,
            q.title,
            q.content,
            m.name AS author_name,
            q.answer,
            q.answered_at,
            q.created_at,
            q.updated_at
        FROM qna q
        INNER JOIN member m ON m.id = q.member_id
        WHERE q.id = #{qnaId}
    </select>

    <insert id="insert" parameterType="com.ssafy.home.qna.mapper.dto.QnaCreateParam" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO qna (
            member_id,
            title,
            content
        ) VALUES (
            #{memberId},
            #{title},
            #{content}
        )
    </insert>

    <update id="updateById" parameterType="com.ssafy.home.qna.mapper.dto.QnaUpdateParam">
        UPDATE qna
        SET
            title = #{title},
            content = #{content},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM qna
        WHERE id = #{qnaId}
    </delete>
</mapper>
