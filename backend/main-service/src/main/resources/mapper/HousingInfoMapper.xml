<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.home.housinginfo.mapper.HousingInfoMapper">

    <select id="findRecent" resultType="com.ssafy.home.housinginfo.mapper.dto.HousingInfoResult">
        SELECT
            id,
            title,
            content,
            source_name,
            source_url,
            info_type,
            published_at
        FROM housing_info
        <where>
            <if test="infoType != null">
                info_type = #{infoType}
            </if>
        </where>
        ORDER BY published_at DESC, id DESC
        LIMIT #{limit}
    </select>

</mapper>
