<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.home.news.mapper.NewsMapper">

    <select id="findRecent" resultType="com.ssafy.home.news.mapper.dto.NewsResult">
        SELECT
            id,
            title,
            summary,
            source_name,
            source_url,
            category,
            published_at
        FROM housing_news
        ORDER BY published_at DESC, id DESC
        LIMIT #{limit}
    </select>

</mapper>
